# ========== API URLs - صرافی‌ها ==========
# Binance Futures
BINANCE_FUTURES_KLINES_URL=https://fapi.binance.com/fapi/v1/klines
BINANCE_FUTURES_DEPTH_URL=https://fapi.binance.com/fapi/v1/depth
BINANCE_FUTURES_TICKER_URL=https://fapi.binance.com/fapi/v1/ticker/24hr

# Binance Spot
BINANCE_SPOT_KLINES_URL=https://api.binance.com/api/v3/klines
BINANCE_SPOT_DEPTH_URL=https://api.binance.com/api/v3/depth

# Bybit
BYBIT_KLINES_URL=https://api.bybit.com/v5/market/kline
BYBIT_DEPTH_URL=https://api.bybit.com/v5/market/orderbook

# OKX
OKX_KLINES_URL=https://www.okx.com/api/v5/market/history-candles
OKX_DEPTH_URL=https://www.okx.com/api/v5/market/books

# CoinMarketCap
COINMARKETCAP_URL=https://pro-api.coinmarketcap.com/v1/cryptocurrency/quotes/latest

# Gemini AI Model
GEMINI_MODEL=gemini-2.0-flash

# ========== فیلترهای سیگنال ==========
MAX_DAILY_SIGNALS=20
MIN_AI_CONFIDENCE=0.70
ALLOWED_TIMEFRAMES=15min,1h,4h
MIN_ADX=25
SIGNAL_COOLDOWN_MINUTES=240
FILTER_BTC_TREND=false

# ========== فیلتر حجم ۲۴ ساعته نسبت به BTC ==========
MIN_BTC_VOLUME=300.0
MAX_BTC_VOLUME=100000.0

MIN_VOLUME_RATIO_TO_BTC=0      # حجم نسبت به BTC (0=خاموش)
MIN_24H_VOLUME_USDT=0          # حداقل حجم دلاری (0=خاموش)
MIN_RSI_LONG=0                 # LONG فقط اگر RSI بالای این (0=خاموش)
MAX_RSI_SHORT=0                # SHORT فقط اگر RSI پایین این (0=خاموش)

# ========== تنظیمات پیشرفته استراتژی RSI+DMI ==========

# فیلتر ترند بزرگ (EMA200)
# true = سیگنال خرید (LONG) فقط وقتی داده می‌شه که قیمت بالای خط ترند بزرگ باشه
# یعنی دیگر وسط سقوط بازار، سیگنال خرید اشتباه نمی‌گیری
S1_EMA200_FILTER=true

# تأیید حجم معاملات
# true = سیگنال فقط وقتی داده می‌شه که حجم کندل فعلی از میانگین حجم بیشتر باشه
# چون شکست قیمت بدون حجم معمولاً جعلی و فریبنده است
S1_VOLUME_CONFIRM=true

# ضریب حجم مورد نیاز
# 1.5 یعنی حجم باید حداقل ۱.۵ برابر میانگین ۲۰ کندل اخیر باشه
# عدد بزرگتر = فیلتر سخت‌تر = سیگنال کمتر ولی قوی‌تر
S1_VOLUME_RATIO=1.5

# قدرت ترند هوشمند (ADX داینامیک)
# true = به جای عدد ثابت ۲۵، ربات خودش با شرایط بازار تطبیق می‌ده
# و فقط وقتی سیگنال می‌ده که قدرت ترند در حال زیاد شدن باشه
S1_DYNAMIC_ADX=true

# جلوگیری از ورود دیر (خرید در سقف)
# true = اگر قیمت خیلی از خط میانگین دور شده باشه، سیگنال نمی‌ده
# یعنی دیر رسیدی و بهتره وارد نشی چون احتمال برگشت قیمت زیاده
S1_ANTI_CHASE=true

# حداکثر فاصله مجاز قیمت از میانگین (به واحد ATR/نوسان)
# 2.0 یعنی اگر قیمت بیشتر از ۲ برابر نوسان معمول از میانگین دور شد، ورود ممنوع
# عدد کوچکتر = سخت‌گیرانه‌تر (سیگنال زودتر ولی کمتر)
S1_ANTI_CHASE_ATR=2.0

# تأیید چند تایم‌فریمه (MTF)
# true = سیگنال RSI+DMI فقط وقتی ارسال می‌شه که تایم ۴ ساعته هم در همان جهت باشه
# مثلاً سیگنال خرید در ۱ ساعته، فقط اگر خریدارها در ۴ ساعته هم قوی‌تر باشن
S1_MTF_CONFIRM=false

# هشدار خروج زودهنگام
# true = بعد از هر سیگنال، ربات ۲۴ ساعت آن کوین را مراقبت می‌کنه
# اگر مومنتوم برعکس شد (کراس DI در تایم ۴h)، پیام «هشدار خروج» به تلگرام میاد
# یعنی قبل از خوردن حد ضرر، فرصت داری دستی خارج شوی
S1_DI_EXIT_ALERT=true

# ========== استراتژی Candle Setup ==========

# سایه بزرگ حداقل چند برابر بدنه باشه (کوچکتر = سیگنال بیشتر)
S2_SHADOW_BIG=2.0

# سایه سمت مقابل حداکثر چند برابر بدنه (کندل تمیز)
S2_SHADOW_SMALL=0.25

# حداقل ضریب حجم نسبت به میانگین
S2_VOLUME_RATIO=1.2

# true = سیگنال فقط نزدیک حمایت/مقاومت
S2_SR_FILTER=true

# حداکثر فاصله از حمایت/مقاومت به درصد (بزرگتر = شل‌تر)
S2_SR_PROXIMITY_PCT=1.5

# ========== استراتژی HH/LL Breakout ==========

# فیلتر جهت SMA7:
# true = شکست نزولی فقط وقتی قیمت زیر SMA7 است (و صعودی فقط بالای SMA7)
# یعنی شکست‌هایی که خلاف ترند کوتاه‌مدت هستن (اغلب فیک) رد می‌شن
S3_SMA7_FILTER=true

# حداقل ضریب حجم برای تأیید شکست (پیش‌فرض 1.5)
S3_VOLUME_RATIO=1.5


# ========== استراتژی ۹: شکست خط روند ==========

# روشن یا خاموش بودن استراتژی
S9_ENABLED=true

# حداقل ضریب حجم برای تأیید شکست
S9_VOLUME_RATIO=1.5

# حداقل چند بار قیمت به خط روند خورده باشه (بیشتر = خط معتبرتر)
S9_MIN_TOUCHES=2

# حداقل فاصله بسته شدن کندل از خط روند (به واحد ATR) — جلوگیری از شکست فیک
S9_BREAK_MARGIN_ATR=0.2

# شکست فقط در جهت SMA7
S9_SMA7_FILTER=true

# قدرت پیوت (بزرگتر = فقط پیوت‌های قوی‌تر)
S9_PIVOT_ORDER=3

# حداکثر قدمت آخرین پیوت به کندل (خطوط خیلی قدیمی نادیده گرفته می‌شن)
S9_MAX_PIVOT_AGE=60

# ========== استراتژی ۴: Engulfing ==========

# فقط نزدیک حمایت/مقاومت سیگنال بده (Engulfing وسط چارت بی‌معنیه)
S4_SR_FILTER=true

# حداکثر فاصله از سطح به درصد
S4_SR_PROXIMITY_PCT=1.5

# فقط در جهت SMA7 (پیش‌فرض خاموش — چون Engulfing معمولاً برگشتیه)
S4_TREND_FILTER=false

# حداقل اندازه بدنه کندل نسبت به ATR (کندل‌های ریز فیلتر می‌شن)
S4_MIN_BODY_ATR=0.8

# حداقل ضریب حجم
S4_VOLUME_RATIO=1.2

# ===== استراتژی ۵: انفجار نوسان =====
S5_ATR_EXPANSION=1.5        # ATR چند برابر شه
S5_MIN_MOVE_PCT=1.0         # حداقل حرکت قیمت (٪)
S5_TREND_FILTER=true        # فقط در جهت ترند بزرگ
S5_VOLUME_RATIO=1.2

# ===== استراتژی ۶: سوییپ سقف/کف مساوی =====
S6_LOOKBACK=10              # کندل‌های جستجو
S6_EQ_TOLERANCE_PCT=0.3     # تلرانس «مساوی» بودن سقف‌ها (٪)
S6_SWEEP_MAX_PCT=0.5        # حداکثر عمق سوییپ (٪)
S6_VOLUME_RATIO=1.2
S6_WICK_REJECT=true         # فتیله برگشت الزامی

# ===== استراتژی ۷: اوردربلاک =====
S7_MIN_BODY_ATR=0.8         # حداقل بدنه نسبت به ATR
S7_VOLUME_RATIO=1.2
S7_DISPLACEMENT=true        # شکست سقف/کف بلاک الزامی

# ===== استراتژی ۸: واگرایی مخفی =====
S8_TREND_FILTER=true        # فقط در جهت SMA7
S8_RSI_FILTER=true          # فیلتر ناحیه RSI


WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_DAY=0        # 0=دوشنبه، 1=سه‌شنبه ... 6=یکشنبه
WEEKLY_REPORT_HOUR=6       # ساعت ارسال (UTC) — 6 یعنی 10:30 به وقت کابل
WEEKLY_TOP_N=10            # چند کوین در لیست باشه


SCAN_FAST_TOP_N=60      # چند کوین در گروه سریع باشه
SCAN_SLOW_EVERY=12      # گروه آروم هر چند اسکن یک بار (12 × 5ثانیه = 1 دقیقه)

OB_WALL_FILTER=true          # فیلتر دیوار
OB_WALL_MIN_MULT=5.0         # دیوار = 5 برابر سفارش متوسط
OB_WALL_BLOCK_PCT=0.5        # فاصله بلاک (0.5%)
OB_BAND_TRAP_FILTER=true     # تشخیص تله لایه‌ای
OB_MOMENTUM_FILTER=true      # فیلتر فشار پایدار
OB_MOMENTUM_MIN=0.15         # آستانه فشار
OB_MOMENTUM_SAMPLES=3        # تعداد قرائت
OB_SPOOF_FILTER=true         # تشخیص دیوار فیک


WEEKLY_REPORT_HOUR=18    # 12:00 UTC = 14:30 شب به وقت کابل

# ========== تنظیمات ربات ==========
CHECK_INTERVAL_SECONDS=30
PORT=8080
