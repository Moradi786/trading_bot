BINANCE_FUTURES_DEPTH_URL=https://fapi.binance.com/fapi/v1/depth
BINANCE_FUTURES_TICKER_URL=https://fapi.binance.com/fapi/v1/ticker/24hr

# Binance Spot
BINANCE_SPOT_KLINES_URL=https://api.binance.com/api/v3/klines
BINANCE_SPOT_DEPTH_URL=https://api.binance.com/api/v3/depth

# Bybit
BYBIT_KLINES_URL=https://api.bybit.com/v5/market/kline
BYBIT_DEPTH_URL=https://api.bybit.com/v5/market/orderbook

# OKX
OKX_KLINES_URL=https://www.okx.com/api/v5/market/history-candles
OKX_DEPTH_URL=https://www.okx.com/api/v5/market/books

# CoinMarketCap
COINMARKETCAP_URL=https://pro-api.coinmarketcap.com/v1/cryptocurrency/quotes/latest

# Gemini AI Model
GEMINI_MODEL=gemini-2.0-flash

# ========== فیلترهای سیگنال ==========
MAX_DAILY_SIGNALS=20
MIN_AI_CONFIDENCE=0.70
ALLOWED_TIMEFRAMES=1h,4h
MIN_ADX=25
SIGNAL_COOLDOWN_MINUTES=240
FILTER_BTC_TREND=true

# ========== فیلتر حجم ۲۴ ساعته نسبت به BTC ==========
MIN_BTC_VOLUME=500.0
MAX_BTC_VOLUME=1600.0

MIN_VOLUME_RATIO_TO_BTC=0      # حجم نسبت به BTC (0=خاموش)
MIN_24H_VOLUME_USDT=0          # حداقل حجم دلاری (0=خاموش)
MIN_RSI_LONG=0                 # LONG فقط اگر RSI بالای این (0=خاموش)
MAX_RSI_SHORT=0                # SHORT فقط اگر RSI پایین این (0=خاموش)


# ========== تنظیمات ربات ==========
CHECK_INTERVAL_SECONDS=30
PORT=8080
