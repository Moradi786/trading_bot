# ========== API URLs - صرافی‌ها ==========
# Binance Futures
BINANCE_FUTURES_KLINES_URL=https://fapi.binance.com/fapi/v1/klines
BINANCE_FUTURES_DEPTH_URL=https://fapi.binance.com/fapi/v1/depth
BINANCE_FUTURES_TICKER_URL=https://fapi.binance.com/fapi/v1/ticker/24hr

# Binance Spot
BINANCE_SPOT_KLINES_URL=https://api.binance.com/api/v3/klines
BINANCE_SPOT_DEPTH_URL=https://api.binance.com/api/v3/depth

# Bybit
BYBIT_KLINES_URL=https://api.bybit.com/v5/market/kline
BYBIT_DEPTH_URL=https://api.bybit.com/v5/market/orderbook

# OKX
OKX_KLINES_URL=https://www.okx.com/api/v5/market/history-candles
OKX_DEPTH_URL=https://www.okx.com/api/v5/market/books

# CoinMarketCap
COINMARKETCAP_URL=https://pro-api.coinmarketcap.com/v1/cryptocurrency/quotes/latest

# Gemini AI Model
GEMINI_MODEL=gemini-2.0-flash

# ========== فیلترهای سیگنال ==========
MAX_DAILY_SIGNALS=20
MIN_AI_CONFIDENCE=0.70
ALLOWED_TIMEFRAMES=1h,4h
MIN_ADX=25
SIGNAL_COOLDOWN_MINUTES=240
FILTER_BTC_TREND=true

# ========== فیلتر حجم ۲۴ ساعته نسبت به BTC ==========
MIN_BTC_VOLUME=500.0
MAX_BTC_VOLUME=1600.0

MIN_VOLUME_RATIO_TO_BTC=0      # حجم نسبت به BTC (0=خاموش)
MIN_24H_VOLUME_USDT=0          # حداقل حجم دلاری (0=خاموش)
MIN_RSI_LONG=0                 # LONG فقط اگر RSI بالای این (0=خاموش)
MAX_RSI_SHORT=0                # SHORT فقط اگر RSI پایین این (0=خاموش)

# ========== تنظیمات پیشرفته استراتژی RSI+DMI ==========

# فیلتر ترند بزرگ (EMA200)
# true = سیگنال خرید (LONG) فقط وقتی داده می‌شه که قیمت بالای خط ترند بزرگ باشه
# یعنی دیگر وسط سقوط بازار، سیگنال خرید اشتباه نمی‌گیری
S1_EMA200_FILTER=true

# تأیید حجم معاملات
# true = سیگنال فقط وقتی داده می‌شه که حجم کندل فعلی از میانگین حجم بیشتر باشه
# چون شکست قیمت بدون حجم معمولاً جعلی و فریبنده است
S1_VOLUME_CONFIRM=true

# ضریب حجم مورد نیاز
# 1.5 یعنی حجم باید حداقل ۱.۵ برابر میانگین ۲۰ کندل اخیر باشه
# عدد بزرگتر = فیلتر سخت‌تر = سیگنال کمتر ولی قوی‌تر
S1_VOLUME_RATIO=1.5

# قدرت ترند هوشمند (ADX داینامیک)
# true = به جای عدد ثابت ۲۵، ربات خودش با شرایط بازار تطبیق می‌ده
# و فقط وقتی سیگنال می‌ده که قدرت ترند در حال زیاد شدن باشه
S1_DYNAMIC_ADX=true

# جلوگیری از ورود دیر (خرید در سقف)
# true = اگر قیمت خیلی از خط میانگین دور شده باشه، سیگنال نمی‌ده
# یعنی دیر رسیدی و بهتره وارد نشی چون احتمال برگشت قیمت زیاده
S1_ANTI_CHASE=true

# حداکثر فاصله مجاز قیمت از میانگین (به واحد ATR/نوسان)
# 2.0 یعنی اگر قیمت بیشتر از ۲ برابر نوسان معمول از میانگین دور شد، ورود ممنوع
# عدد کوچکتر = سخت‌گیرانه‌تر (سیگنال زودتر ولی کمتر)
S1_ANTI_CHASE_ATR=2.0

# تأیید چند تایم‌فریمه (MTF)
# true = سیگنال RSI+DMI فقط وقتی ارسال می‌شه که تایم ۴ ساعته هم در همان جهت باشه
# مثلاً سیگنال خرید در ۱ ساعته، فقط اگر خریدارها در ۴ ساعته هم قوی‌تر باشن
S1_MTF_CONFIRM=true

# هشدار خروج زودهنگام
# true = بعد از هر سیگنال، ربات ۲۴ ساعت آن کوین را مراقبت می‌کنه
# اگر مومنتوم برعکس شد (کراس DI در تایم ۴h)، پیام «هشدار خروج» به تلگرام میاد
# یعنی قبل از خوردن حد ضرر، فرصت داری دستی خارج شوی
S1_DI_EXIT_ALERT=true

# ========== استراتژی Candle Setup ==========

# سایه بزرگ حداقل چند برابر بدنه باشه (کوچکتر = سیگنال بیشتر)
S2_SHADOW_BIG=2.0

# سایه سمت مقابل حداکثر چند برابر بدنه (کندل تمیز)
S2_SHADOW_SMALL=0.25

# حداقل ضریب حجم نسبت به میانگین
S2_VOLUME_RATIO=1.2

# true = سیگنال فقط نزدیک حمایت/مقاومت
S2_SR_FILTER=true

# حداکثر فاصله از حمایت/مقاومت به درصد (بزرگتر = شل‌تر)
S2_SR_PROXIMITY_PCT=1.5



# ========== تنظیمات ربات ==========
CHECK_INTERVAL_SECONDS=30
PORT=8080
